# ==============================================================================
# 🚀 SCHOLARPILOT AI - PRODUCTION ENVIRONMENT CONFIGURATION
# Stack: Frontend + FastAPI -> Render -> PostgreSQL (Neon) -> Resend -> Google AI Studio
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 🐘 DATABASE: NEON POSTGRESQL (https://neon.tech)
# ------------------------------------------------------------------------------
# Copy the Connection String from your Neon Dashboard.
# Note: SQLAlchemy requires "postgresql://" (automatic conversion is included).
# sslmode=require is automatically handled for Neon connections.
DATABASE_URL=postgresql://neondb_owner:npg_your_password@ep-bold-sample-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. 📧 EMAILS: RESEND API (https://resend.com)
# ------------------------------------------------------------------------------
# Free tier provides 3,000 emails/month without blocked SMTP ports.
# Obtain API key starting with 're_' from: https://resend.com/api-keys
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Sender name & address:
# If you haven't verified a custom domain yet, use Resend's default test sender:
RESEND_FROM_EMAIL=ScholarPilot AI <onboarding@resend.dev>
# Once you verify your domain (e.g. yourdomain.com):
# RESEND_FROM_EMAIL=ScholarPilot AI <admissions@yourdomain.com>

# ------------------------------------------------------------------------------
# 3. 🤖 AI BRAIN: GOOGLE AI STUDIO (https://aistudio.google.com)
# ------------------------------------------------------------------------------
# Generate your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyYourGoogleAIStudioGeminiApiKeyHere

# Active Gemini model:
# Recommended: gemini-2.5-flash (fast, multimodal, 1M context) or gemini-3.5-flash-lite
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 4. 🛡️ SECURITY & SESSION INTEGRITY
# ------------------------------------------------------------------------------
# Cryptographically secure string used for HMAC signing of session tokens.
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_64_character_random_hex_string_in_production

# Allowed CORS origins (comma-separated). Set to your Render URL or *
ALLOWED_ORIGINS=*

# ------------------------------------------------------------------------------
# 5. 📬 FALLBACK EMAIL: GMAIL SMTP (OPTIONAL)
# ------------------------------------------------------------------------------
# Only used if RESEND_API_KEY is not provided.
SENDER_EMAIL=
GMAIL_APP_PASSWORD=
RECIPIENT_EMAIL=

# ------------------------------------------------------------------------------
# 6. 🔍 OPTIONAL INTEGRATIONS
# ------------------------------------------------------------------------------
# Optional: Official high-speed web search API (https://tavily.com)
TAVILY_API_KEY=

# Optional: Interactive Telegram Bot (@BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
