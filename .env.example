# Telegram Bot API Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key obtained from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini Model (defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional: Public Telegram Channel username/ID for broadcasting urgent scholarships (e.g., @MyScholarshipsChannel)
TELEGRAM_CHANNEL_ID=

# Optional: Official Search APIs (if provided, will be preferred over DuckDuckGo)
TAVILY_API_KEY=
SERPAPI_API_KEY=

# Database Cache TTL in hours (default: 24)
CACHE_TTL_HOURS=24
