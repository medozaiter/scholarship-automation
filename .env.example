# ==========================================
# 📧 EMAIL AUTOMATION CREDENTIALS (GMAIL)
# ==========================================
# Your Gmail address used to send the weekly scholarship reports
SENDER_EMAIL=your_email@gmail.com

# 16-character Google App Password (generated from: https://myaccount.google.com/apppasswords)
# Note: Google 2-Step Verification must be enabled on your account
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Destination email where you want to receive the weekly reports (defaults to SENDER_EMAIL if blank)
RECIPIENT_EMAIL=your_email@gmail.com

# ==========================================
# 🤖 AI & SEARCH CONFIGURATION
# ==========================================
# Google Gemini API Key obtained from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended Gemini Model (fast, highly available)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Official High-Speed Search API (Leave blank to use DuckDuckGo scraper)
TAVILY_API_KEY=

# Cache TTL in hours
CACHE_TTL_HOURS=24

# ==========================================
# 💬 TELEGRAM BOT (OPTIONAL / INTERACTIVE)
# ==========================================
# Telegram Bot API Token obtained from @BotFather (if you wish to run the interactive Telegram bot)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: Public Channel Broadcasting (e.g. @MyScholarshipsChannel)
TELEGRAM_CHANNEL_ID=
